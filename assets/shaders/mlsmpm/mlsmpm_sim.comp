#version 460 core
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) buffer PosBuffer {
    vec4 positions[];
};

layout(std430, binding = 1) buffer VBuffer {
    vec4 velocities[]; // vec3 velocity + float mass
};

layout(std430, binding = 2) buffer GridBuffer {
    vec4 gridStatus[]; // vec3 velocity + float mass
};

layout(std430, binding = 3) buffer CBuffer {
    mat3 affineC[]; // APIC affine velocity field
};

layout(std430, binding = 4) buffer FBuffer {
    mat3 F[]; // deformation gradient
};

uniform float deltaTime;
uniform ivec3 gridRes;
uniform int gridBoundary;

uniform float gridSpacing;
uniform vec3 gridOrigin;

uniform int interactionMode;
uniform vec3 interactionCenter;
uniform vec3 interactionDirection;
uniform float interactionRadius;
uniform float interactionStrength;

vec3 computeInteractionAcceleration(vec3 p)
{
    if (interactionMode == 0) {
        return vec3(0.0);
    }

    vec3 toParticle = p - interactionCenter;
    float r = length(toParticle);

    if (r >= interactionRadius || interactionRadius <= 1e-6) {
        return vec3(0.0);
    }

    float q = r / interactionRadius;
    float w = (1.0 - q) * (1.0 - q);

    vec3 dir = normalize(interactionDirection + vec3(1e-6));

    if (interactionMode == 1) {
        return dir * interactionStrength * w;
    }

    if (interactionMode == 2) {
        vec3 toCenter = interactionCenter - p;
        float len = length(toCenter);
        if (len < 1e-6) return vec3(0.0);
        return normalize(toCenter) * interactionStrength * w;
    }

    if (interactionMode == 3) {
        if (r < 1e-6) return vec3(0.0);
        return normalize(toParticle) * interactionStrength * w;
    }

    if (interactionMode == 4) {
        vec3 axis = normalize(interactionDirection + vec3(1e-6));
        vec3 tangent = cross(axis, toParticle);
        float tLen = length(tangent);
        if (tLen < 1e-6) return vec3(0.0);
        return normalize(tangent) * interactionStrength * w;
    }

    // 5: ray-based repel
    // interactionCenter    = ray origin
    // interactionDirection = ray direction
    if (interactionMode == 5) {
        vec3 rayOrigin = interactionCenter;
        vec3 rayDir = normalize(interactionDirection + vec3(1e-6));

        vec3 op = p - rayOrigin;

        // point projection onto ray
        float t = dot(op, rayDir);

        // ignore particles behind the camera
        if (t < 0.0) {
            return vec3(0.0);
        }

        vec3 closest = rayOrigin + t * rayDir;
        vec3 radial = p - closest;

        float dist = length(radial);

        if (dist >= interactionRadius) {
            return vec3(0.0);
        }

        float q = dist / interactionRadius;
        float w = (1.0 - q) * (1.0 - q);

        vec3 radialDir;

        if (dist < 1e-6) {
            // if exactly on the ray, push slightly sideways using a stable fallback
            radialDir = normalize(cross(rayDir, vec3(0.0, 1.0, 0.0)) + vec3(1e-6));
        }
        else {
            radialDir = radial / dist;
        }

        // Mainly push away from the ray.
        // Add a small ray-direction component so the effect is visible from camera view.
        return (radialDir + 0.15 * rayDir) * interactionStrength * w;
    }

    return vec3(0.0);
}

ivec3 getBoundaryCells(ivec3 gridRes, int gridBoundary)
{
    int maxXZ = max(1, min(gridRes.x, gridRes.z) / 2 - 2);

    int boundaryXZ = clamp(gridBoundary, 1, maxXZ);

    int fixedYBoundary = 3;
    int maxY = max(1, gridRes.y / 2 - 2);
    int boundaryY = clamp(fixedYBoundary, 1, maxY);

    return ivec3(boundaryXZ, boundaryY, boundaryXZ);
}

void main() {
    ivec3 id = ivec3(gl_GlobalInvocationID.xyz);
    if (any(greaterThanEqual(id, vec3(gridRes)))) return;

    int index = id.x + gridRes.x * id.y + gridRes.x * gridRes.y * id.z;
    vec4 status = gridStatus[index];
    float mass = status.w;

    if (mass > 0.0) {
        vec3 velocity = status.xyz / mass;

        // Add external force (gravity)
        velocity.y += deltaTime * -9.8;

        // Right-click fluid interaction
        vec3 nodePos = gridOrigin + (vec3(id) + vec3(0.5)) * gridSpacing;
        velocity += deltaTime * computeInteractionAcceleration(nodePos);

        // Handle boundary
        ivec3 boundary = getBoundaryCells(gridRes, gridBoundary);

        if (id.y > gridRes.y - boundary.y - 1 && velocity.y > 0.0) velocity.y = 0.0;
        if (id.y < boundary.y && velocity.y < 0.0) velocity.y = 0.0;

        if (id.x > gridRes.x - boundary.x - 1 && velocity.x > 0.0) velocity.x = 0.0;
        if (id.x < boundary.x && velocity.x < 0.0) velocity.x = 0.0;

        if (id.z > gridRes.z - boundary.z - 1 && velocity.z > 0.0) velocity.z = 0.0;
        if (id.z < boundary.z && velocity.z < 0.0) velocity.z = 0.0;

        // Write back
        gridStatus[index].xyz = velocity;  
    }
}
