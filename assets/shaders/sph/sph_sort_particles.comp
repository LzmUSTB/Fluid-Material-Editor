#version 460 core

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer PosBuffer {
    vec4 positions[];
};

layout(std430, binding = 6) readonly buffer CellOffsetBuffer {
    uint cellOffsets[];
};

layout(std430, binding = 7) buffer SortedParticleBuffer {
    uint sortedParticles[];
};

layout(std430, binding = 8) buffer CellScratchBuffer {
    uint cellScratch[];
};

uniform float cellSize;
uniform ivec3 gridRes;
uniform vec3 gridOrigin;
uniform int particleCount;

bool computeCellHash(vec3 pos, out uint hash)
{
    ivec3 cell = ivec3(floor((pos - gridOrigin) / cellSize));

    if (any(lessThan(cell, ivec3(0))) || any(greaterThanEqual(cell, gridRes))) {
        return false;
    }

    hash = uint(cell.x + cell.y * gridRes.x + cell.z * gridRes.x * gridRes.y);
    return true;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(particleCount)) return;

    uint hash;
    if (!computeCellHash(positions[id].xyz, hash)) return;

    uint localIndex = atomicAdd(cellScratch[hash], 1u);
    sortedParticles[cellOffsets[hash] + localIndex] = id;
}
