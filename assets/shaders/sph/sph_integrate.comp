#version 460 core
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PosBuffer {
    vec4 positions[]; // vec3 position + float density
};

layout(std430, binding = 1) buffer VBuffer {
    vec4 velocities[]; // vec3 velocity + float mass
};

layout(std430, binding = 9) buffer ForceBuffer {
    vec4 force[]; // vec3 force + float nearDensity
};

uniform int particleCount;
uniform float deltaTime;
uniform float cellSize;
uniform int gridBoundary;
uniform vec3 gridOrigin;
uniform ivec3 gridRes;

uniform int interactionMode;
uniform vec3 interactionCenter;
uniform vec3 interactionDirection;
uniform float interactionRadius;
uniform float interactionStrength;

uniform float wallStiffness;

ivec3 getBoundaryCells(ivec3 gridRes, int gridBoundary)
{
    int maxXZ = max(1, min(gridRes.x, gridRes.z) / 2 - 2);

    int boundaryXZ = clamp(gridBoundary, 1, maxXZ);

    int fixedYBoundary = 3;
    int maxY = max(1, gridRes.y / 2 - 2);
    int boundaryY = clamp(fixedYBoundary, 1, maxY);

    return ivec3(boundaryXZ, boundaryY, boundaryXZ);
}

void applyBoundary(inout vec3 p, inout vec3 v, vec3 boxMin, vec3 boxMax)
{
    if (p.x < boxMin.x) {
        p.x = boxMin.x;
        if (v.x < 0.0) v.x = 0.0;
    }

    if (p.x > boxMax.x) {
        p.x = boxMax.x;
        if (v.x > 0.0) v.x = 0.0;
    }

    if (p.y < boxMin.y) {
        p.y = boxMin.y;
        if (v.y < 0.0) v.y = 0.0;
    }

    if (p.y > boxMax.y) {
        p.y = boxMax.y;
        if (v.y > 0.0) v.y = 0.0;
    }

    if (p.z < boxMin.z) {
        p.z = boxMin.z;
        if (v.z < 0.0) v.z = 0.0;
    }

    if (p.z > boxMax.z) {
        p.z = boxMax.z;
        if (v.z > 0.0) v.z = 0.0;
    }
} 

vec3 computeInteractionAcceleration(vec3 p)
{
    if (interactionMode == 0) {
        return vec3(0.0);
    }

    // 5: ray-based repel
    // interactionCenter    = ray origin
    // interactionDirection = ray direction
    //
    // 重要：
    // mode 5 は「rayとの距離」で判定するので、
    // 通常の sphere radius check より前に処理する。
    if (interactionMode == 5) {
        vec3 rayOrigin = interactionCenter;
        vec3 rayDir = normalize(interactionDirection + vec3(1e-6));

        vec3 op = p - rayOrigin;
        float t = dot(op, rayDir);

        // カメラより後ろの粒子は無視
        if (t < 0.0) {
            return vec3(0.0);
        }

        vec3 closest = rayOrigin + t * rayDir;
        vec3 radial = p - closest;

        float dist = length(radial);

        if (dist >= interactionRadius || interactionRadius <= 1e-6) {
            return vec3(0.0);
        }

        float q = dist / interactionRadius;
        float w = (1.0 - q) * (1.0 - q);

        vec3 radialDir;

        if (dist < 1e-6) {
            vec3 fallback = cross(rayDir, vec3(0.0, 1.0, 0.0));
            if (length(fallback) < 1e-6) {
                fallback = cross(rayDir, vec3(1.0, 0.0, 0.0));
            }
            radialDir = normalize(fallback);
        }
        else {
            radialDir = radial / dist;
        }

        return normalize(radialDir + 0.20 * rayDir) * interactionStrength * w;
    }

    vec3 toParticle = p - interactionCenter;
    float r = length(toParticle);

    if (r >= interactionRadius || interactionRadius <= 1e-6) {
        return vec3(0.0);
    }

    float q = r / interactionRadius;
    float w = (1.0 - q) * (1.0 - q);

    vec3 dir = normalize(interactionDirection + vec3(1e-6));

    // 1: directional push
    if (interactionMode == 1) {
        return dir * interactionStrength * w;
    }

    // 2: attract
    if (interactionMode == 2) {
        vec3 toCenter = interactionCenter - p;
        float len = length(toCenter);
        if (len < 1e-6) return vec3(0.0);
        return normalize(toCenter) * interactionStrength * w;
    }

    // 3: repel
    if (interactionMode == 3) {
        if (r < 1e-6) return vec3(0.0);
        return normalize(toParticle) * interactionStrength * w;
    }

    // 4: vortex
    if (interactionMode == 4) {
        vec3 axis = normalize(interactionDirection + vec3(1e-6));
        vec3 tangent = cross(axis, toParticle);
        float tLen = length(tangent);
        if (tLen < 1e-6) return vec3(0.0);
        return normalize(tangent) * interactionStrength * w;
    }

    return vec3(0.0);
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= uint(particleCount)) return;

    float density = positions[id].w;
    if (density <= 1e-6) return;

    vec3 gridEnd = vec3(cellSize * gridRes) + gridOrigin;

    ivec3 boundaryCells = getBoundaryCells(gridRes, gridBoundary);

    vec3 boxMin = gridOrigin + vec3(boundaryCells) * cellSize;
    vec3 boxMax = gridEnd - vec3(boundaryCells) * cellSize;

    vec3 p = positions[id].xyz;
    vec3 v = velocities[id].xyz;

    vec3 a = force[id].xyz / density;
    a += computeInteractionAcceleration(positions[id].xyz);

    v += deltaTime * a;

    v *= 0.998;

    float maxSpeed = 4.0;
    float speed = length(v);
    if (speed > maxSpeed) {
        v = v / speed * maxSpeed;
    }

    p += deltaTime * v;

    applyBoundary(p, v, boxMin, boxMax);

    positions[id].xyz = p;
    velocities[id].xyz = v;
}