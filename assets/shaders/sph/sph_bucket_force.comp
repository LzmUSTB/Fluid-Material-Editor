#version 460 core
#define MAX_PARTICLES_PER_CELL 128u

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) buffer PosBuffer {
    vec4 positions[]; // vec3 position + float density
};

layout(std430, binding = 1) buffer VBuffer {
    vec4 velocities[]; // vec3 velocity + float mass
};

layout(std430, binding = 5) buffer CellCountBuffer {
    uint cellCounts[];
};

layout(std430, binding = 6) buffer CellParticleBuffer {
    uint cellParticles[];
};

layout(std430, binding = 9) buffer ForceBuffer {
    vec4 force[]; // vec3 force + float nearDensity
};

uniform ivec3 gridRes;
uniform vec3 gridOrigin;
uniform int particleCount;

uniform float restDensity;
uniform float stiffness;
uniform float nearStiffness;
uniform float viscosity;
uniform float h;

float densityKernelGradient(float r, float h)
{
    float factor = 45.0 / (3.1415926535 * pow(h, 6.0));
    return factor * pow(h - r, 2.0);
}

float nearDensityKernelGradient(float r, float h)
{
    float factor = 45.0 / (3.1415926535 * pow(h, 5.0));
    return factor * pow(h - r, 2.0);
}

float viscosityKernelLaplacian(float r, float h)
{
    float factor = 45.0 / (3.1415926535 * pow(h, 6.0));
    return factor * (h - r);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(particleCount)) return;

    vec3 pi = positions[i].xyz;

    float density_i = positions[i].w;
    float nearDensity_i = force[i].w;

    // densityが未計算・範囲外などの場合でも重力だけは入れる
    if (density_i <= 1e-6) {
        force[i].xyz = vec3(0.0, -9.8, 0.0);
        return;
    }

    vec3 f_pressure = vec3(0.0);
    vec3 f_viscosity = vec3(0.0);

    ivec3 baseCell = ivec3(floor((pi - gridOrigin) / h));

    float pressure_i = stiffness * (density_i - restDensity);
    float nearPressure_i = nearStiffness * nearDensity_i;

    for (int dx = -1; dx <= 1; ++dx)
    for (int dy = -1; dy <= 1; ++dy)
    for (int dz = -1; dz <= 1; ++dz) {
        ivec3 neighborCell = baseCell + ivec3(dx, dy, dz);

        if (any(lessThan(neighborCell, ivec3(0))) ||
            any(greaterThanEqual(neighborCell, gridRes))) {
            continue;
        }

        uint hash = uint(
            neighborCell.x +
            neighborCell.y * gridRes.x +
            neighborCell.z * gridRes.x * gridRes.y
        );

        uint count = min(cellCounts[hash], MAX_PARTICLES_PER_CELL);

        for (uint j = 0u; j < count; ++j) {
            uint neighborIdx = cellParticles[hash * MAX_PARTICLES_PER_CELL + j];

            if (neighborIdx == i) continue;

            vec3 pj = positions[neighborIdx].xyz;
            vec3 rij = pi - pj;

            float rLen = length(rij);

            if (rLen >= h || rLen <= 1e-6) continue;

            float density_j = positions[neighborIdx].w;
            float nearDensity_j = force[neighborIdx].w;

            if (density_j <= 1e-6) continue;

            float neighborMass = velocities[neighborIdx].w;

            float densitySafe = max(density_j, 1e-6);
            float nearDensitySafe = max(nearDensity_j, 1e-6);

            float pressure_j = stiffness * (density_j - restDensity);
            float nearPressure_j = nearStiffness * nearDensity_j;

            float sharedPressure = 0.5 * (pressure_i + pressure_j);
            float nearSharedPressure = 0.5 * (nearPressure_i + nearPressure_j);

            // pj - pi 方向
            vec3 dir = normalize(pj - pi);

            f_pressure += -sharedPressure * neighborMass * dir
                        * densityKernelGradient(rLen, h) / densitySafe;

            f_pressure += -nearSharedPressure * neighborMass * dir
                        * nearDensityKernelGradient(rLen, h) / nearDensitySafe;

            vec3 relativeVelocity = velocities[neighborIdx].xyz - velocities[i].xyz;

            f_viscosity += neighborMass * relativeVelocity
                         * viscosityKernelLaplacian(rLen, h) / densitySafe;
        }
    }

    vec3 f_gravity = vec3(0.0, -9.8, 0.0) * density_i;

    f_viscosity *= viscosity;

    force[i].xyz = f_pressure + f_viscosity + f_gravity;
}